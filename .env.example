# Copie para .env e ajuste. Usado pelo docker-compose.
AIRFLOW_UID=1000
AIRFLOW_DAGS=./dags
AIRFLOW_LOGS=./logs
AIRFLOW_PLUGINS=./plugins
# Pasta com variables.yaml e connections.yaml (secrets backend do Airflow)
AIRFLOW_SECRETS=./secrets

# Em secrets/variables.yaml defina as Variables lidas pelas DAGs, por exemplo:
#   MONGO_URI: mongodb://username:password@mongodb:27017/?authSource=admin
#   POSTGRESQL_URI: postgresql+psycopg2://username:password@real_state_postgres:5432/real_state
#   S3_ACCESS_KEY: username
#   S3_SECRET_KEY: password

# Opcional: webhook (formato Slack) para alertar falhas das DAGs
ALERT_WEBHOOK_URL=
